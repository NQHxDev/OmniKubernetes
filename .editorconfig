# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Rust source files (aligned with rustfmt defaults)
[*.rs]
indent_style = space
indent_size = 4
max_line_length = 100

# TOML configuration files (Cargo manifests, etc.)
[*.toml]
indent_style = space
indent_size = 4

# YAML configuration files (Kubernetes manifests, GitHub Actions, CI/CD)
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON files
[*.json]
indent_style = space
indent_size = 4

# Markdown documentation
[*.md]
indent_size = 4
trim_trailing_whitespace = false

# Makefiles require tab indentation
[Makefile]
indent_style = tab

# Shell scripts
[*.{sh,bash}]
indent_style = space
indent_size = 4
