# --- Service Identity ---
OMNI__SERVICE__NAME=omni-service
OMNI__SERVICE__ENVIRONMENT=dev
OMNI__SERVICE__REGION=ap-southeast-1

# --- Server ---
OMNI__SERVER__HOST=0.0.0.0
OMNI__SERVER__PORT=8080
OMNI__SERVER__GRPC_PORT=50051
OMNI__SERVER__REQUEST_TIMEOUT_SECS=30
OMNI__SERVER__SHUTDOWN_TIMEOUT_SECS=15
OMNI__SERVER__MAX_BODY_SIZE_BYTES=2097152

# --- Logging & Tracing ---
OMNI__LOGGING__LOG_LEVEL=debug
OMNI__LOGGING__LOG_FORMAT=pretty
OMNI__LOGGING__BUFFERED_LINES_LIMIT=10000
OMNI__LOGGING__LOSSY=true
# OMNI__LOGGING__OTLP_ENDPOINT=http://localhost:4317

# --- Observability ---
OMNI__OBSERVABILITY__METRICS_ENABLED=true
OMNI__OBSERVABILITY__METRICS_PATH=/metrics
OMNI__OBSERVABILITY__OPENAPI_ENABLED=true
OMNI__OBSERVABILITY__OPENAPI_JSON_PATH=/v3/api-docs/openapi.json
OMNI__OBSERVABILITY__SWAGGER_UI_ENABLED=true
OMNI__OBSERVABILITY__SAMPLING_RATIO=1.0

# --- Database ---
OMNI__DATABASE__ENABLED=false
OMNI__DATABASE__HOST=localhost
OMNI__DATABASE__PORT=5432
OMNI__DATABASE__USERNAME=omni_user
OMNI__DATABASE__PASSWORD=dev_only_password_change_me
OMNI__DATABASE__DATABASE_NAME=omni_db
OMNI__DATABASE__SSL_MODE=prefer
OMNI__DATABASE__MAX_CONNECTIONS=20
OMNI__DATABASE__MIN_CONNECTIONS=2
OMNI__DATABASE__ACQUIRE_TIMEOUT_SECS=5

# --- Redis ---
OMNI__REDIS__ENABLED=false
OMNI__REDIS__HOST=localhost
OMNI__REDIS__PORT=6379
# OMNI__REDIS__PASSWORD=
OMNI__REDIS__DATABASE_INDEX=0
OMNI__REDIS__POOL_SIZE=16

# --- Auth ---
OMNI__AUTH__ENABLED=false
OMNI__AUTH__JWT_ALGORITHM=HS256
OMNI__AUTH__JWT_SECRET=dev_only_jwt_secret_key_must_be_at_least_32_bytes_long
OMNI__AUTH__ACCESS_TOKEN_TTL_SECS=900
OMNI__AUTH__REFRESH_TOKEN_TTL_SECS=604800

# --- Messaging ---
OMNI__MESSAGING__ENABLED=false
OMNI__MESSAGING__BROKER_URL=amqp://guest:guest@localhost:5672/%2f

# --- Resilience ---
OMNI__RESILIENCE__RATE_LIMIT_ENABLED=true
OMNI__RESILIENCE__RATE_LIMIT_RPS=100
OMNI__RESILIENCE__RATE_LIMIT_BURST=200

# --- i18n ---
OMNI__I18N__LOCALES_DIR=libs/common/locales
OMNI__I18N__DEFAULT_LOCALE=vi-VN

