#!/bin/sh

# ANSI color codes for pretty output
RED='\033[0;31m'
YELLOW='\033[0;33m'
BOLD='\033[1m'
NC='\033[0m'

# Check current branch
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)

case "$CURRENT_BRANCH" in
    main|staging|master)
        # Allow git pull / syncing from remote tracking branch
        case "$GIT_REFLOG_ACTION" in
            pull*|*origin/*|*upstream/*)
                exit 0
                ;;
        esac

        printf "%b\n" "\n${RED}${BOLD}✖ [BLOCKED]${NC} Fast-forward merge into protected branch '${YELLOW}${CURRENT_BRANCH}${NC}' detected!"
        printf "%b\n" "  Local merges into '${YELLOW}${CURRENT_BRANCH}${NC}' are prohibited."
        printf "%b\n" "  Automatically rolling back branch to previous state...\n"

        git reset --hard ORIG_HEAD
        exit 1
        ;;
esac

exit 0

