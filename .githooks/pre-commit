#         printf "%b\n" "${RED}${BOLD}✖ [FAILED] Cargo Hakari dependency diff detected!${NC}"
#         printf "%b\n" "  ${YELLOW}Fix:${NC} Run ${BOLD}cargo hakari generate${NC} and stage the updated files...\n"
#         exit 1
#     fi
# fi

printf "%b\n" "${GREEN}${BOLD}✔ [PASSED] All checks passed successfully!${NC}\n"
exit 0
