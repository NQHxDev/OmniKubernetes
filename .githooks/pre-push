#!/bin/sh

# Prevent direct push to protected branches
RED='\033[0;31m'
YELLOW='\033[0;33m'
BOLD='\033[1m'
NC='\033[0m'

has_error=0

while read -r local_ref local_oid remote_ref remote_oid; do
    remote_branch="${remote_ref#refs/heads/}"

    case "$remote_branch" in
        main|staging|master)
            printf "%b\n" "\n${RED}${BOLD}✖ [BLOCKED]${NC} Direct push to protected branch '${YELLOW}${remote_branch}${NC}' is not allowed..."
            printf "%b\n" "  Please push to a feature branch and open a Pull Request..."
            printf "%b\n" "  Bypass with '--no-verify' only for emergencies...\n"
            has_error=1
            ;;
    esac
done

[ "$has_error" -eq 1 ] && exit 1
exit 0
