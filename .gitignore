crash.log
crash.*.log

# Variables files with sensitive values
*.tfvars
*.tfvars.json
!*.example.tfvars
!*.template.tfvars

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

