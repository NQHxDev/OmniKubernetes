!infra/kubernetes/secrets/.gitkeep
!infra/kubernetes/secrets/*.example.yaml
!infra/kubernetes/secrets/*.example.yml
!infra/kubernetes/secrets/*.template.yaml
!infra/kubernetes/secrets/*.template.yml
*.secret.yaml
*.secret.yml
secrets.yaml
secrets.yml

# Image archives and container runtime caches
*.tar
.docker/

# Cluster connection configs
kubeconfig
*kubeconfig*
.kube/

# Helm package archives
*.tgz
infra/helm/charts/*.tgz

# Local .terraform working directories
**/.terraform/*
.terraform/

# Terraform state files & backups
*.tfstate
*.tfstate.*
*.tfstate.backup

