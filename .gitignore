# Build artifacts
/target/
target/

# Backup and temporary files generated by cargo / rustc
**/*.rs.bk
*.bk

# Profiling and coverage artifacts
*.profraw
*.profdata
coverage/
tarpaulin-report.*

# Local Cargo configuration overrides and cache
cargo-cache/
.cargo/config.toml.local

# Environment files
.env
.env.*
!.env.example
!.env.template

